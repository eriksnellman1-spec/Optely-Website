# Kopiera till .env.local (lokalt) och lägg in samma värden i Vercel.
# Hittas i Supabase: Project Settings → API.

# Publika – når webbläsaren
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Hemliga – bara servern. Får ALDRIG prefixas med NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Delad hemlighet för n8n → appen (header x-optely-secret).
# Generera t.ex. med: openssl rand -hex 32
WEBHOOK_SECRET=<lång-slumpad-sträng>

# n8n-flödet "partnermejl från Gmail" (Webhook-noden, Production URL). Knappen "Synka Gmail" på Översikt
# anropar den med samma x-optely-secret som ovan. Ex: https://<din-n8n>/webhook/optely-gmail-sync
N8N_GMAIL_SYNC_URL=<n8n-webhook-url>

# Skyddar det dagliga cron-jobbet /api/cron/sequence. Vercel skickar det automatiskt
# som "Authorization: Bearer <CRON_SECRET>" när variabeln finns i projektet.
# Generera t.ex. med: openssl rand -hex 32
CRON_SECRET=<lång-slumpad-sträng>

# Endast för Supabase CLI (db push / gen types) – används inte av appen.
# SUPABASE_ACCESS_TOKEN=<personal-access-token>
# SUPABASE_DB_PASSWORD=<databaslösenord>

      },
      "name": "Sökningar: skickat",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "returnAll": true,
        "simple": true,
        "filters": {
          "q": "={{ $json.sent }}"
        }
      },
      "name": "Gmail: skickat",

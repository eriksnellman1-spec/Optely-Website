        "method": "POST",
        "url": "https://DIN-APP.vercel.app/api/webhooks/n8n",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'gmail.message', direction: 'sent', message: { id: $json.id, threadId: $json.threadId, From: $json.From, To: $json.To, Cc: $json.Cc, Subject: $json.Subject, snippet: $json.snippet, internalDate: $json.internalDate, labelIds: $json.labelIds } }) }}",
        "options": {}
      },
      "name": "Till appen: skickat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Optely O.R. webhook"
        }
      }
    },

{
  "name": "Optely O.R. – partnermejl från Gmail",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "name": "Var 10:e minut",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        100
      ]
    },
    {
      "parameters": {
        "url": "https://DIN-APP.vercel.app/api/webhooks/n8n/gmail-query?minutes=11",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "name": "Var 10:e min: hämta partnersökning",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        250,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Optely O.R. webhook"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "sent",
        "options": {}
      },
      "name": "Var 10:e min: sökningar skickat",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        500,
        0

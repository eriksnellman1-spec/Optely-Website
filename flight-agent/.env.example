# Kopiera till .env och fyll i. .env checkas aldrig in.

# Claude (valfritt – för AI-analysen). Skapa nyckel på console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Telegram: skapa en bot hos @BotFather, skriv "hej" till boten,
# kör sedan:  python -m flightagent.cli telegram-chatid
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: Serverinställningar → Integrationer → Webhooks → Ny webhook → Kopiera URL
DISCORD_WEBHOOK_URL=

# Kalendrar (kommaseparerade). Google: Inställningar → kalendern →
# "Hemlig adress i iCal-format". Lokala .ics-filer fungerar också.
CALENDAR_ICS_URLS=
